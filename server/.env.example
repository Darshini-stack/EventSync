# Server Port & Host Configuration
PORT=5000
HOST=0.0.0.0
NODE_ENV=development

# Database Configuration
MONGODB_URI=mongodb://127.0.0.1:27017/eventsync

# Security & Secrets (Generate strong random keys for production)
JWT_SECRET=your_secure_random_64_char_hex_jwt_secret_here
ADMIN_ACCESS_CODE=your_secure_admin_access_code_here

# Allowed CORS Origins (comma-separated if multiple)
# Allows localhost as well as LAN/mobile clients
CLIENT_URL=http://localhost:5173

# Public Application URL (Base URL for shareable event registration QR codes)
PUBLIC_APP_URL=https://your-eventsync-domain.com

# Notification Thresholds
NOTIFICATION_ALMOST_FULL_THRESHOLD=5

# AI Assistant LLM API Configuration (Google Gemini / OpenAI compatible)
LLM_API_KEY=your_llm_api_key_here
